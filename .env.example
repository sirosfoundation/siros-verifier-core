# Copy to .env and replace every placeholder. Never commit .env or private keys.
# Loopback HTTP only. For HTTPS, use the production profile with Secure cookies.
SIROS_VERIFIER_BASE_URL=http://localhost:9001
SIROS_VERIFIER_DNS_NAME=localhost
SIROS_VERIFIER_STATE_KEY=replace-with-64-or-more-random-hex-characters
SIROS_PDP_ENDPOINT=https://pdp.example/evaluation
# SIROS_PDP_BEARER_TOKEN=only-if-your-pdp-requires-it

MONGODB_ROOT_PASSWORD=replace-with-a-random-root-password
# The application password goes into the Mongo URI userinfo. Use only URI-unreserved
# characters [A-Za-z0-9._~-]; `openssl rand -hex 32` is suitable. Do not percent-encode it.
MONGODB_APP_PASSWORD=replace-with-a-different-random-application-password

# The private key must be PKCS#8 PEM ("PRIVATE KEY"), with a DNS-SAN certificate chain.
# The container runs as UID/GID 10001 and mounts keep host-file permissions:
# a 0600 key owned by another UID fails startup. See docs/INTEGRATORS.md
# (Docker Compose, step 2) for the safe permission setup.
VERIFIER_PRIVATE_KEY_PATH=./secrets/verifier_ec_private.pem
VERIFIER_CHAIN_PATH=./secrets/verifier_ec_chain.pem

# Optional defaults:
# SIROS_VERIFIER_BIND_ADDRESS=127.0.0.1
# SIROS_VERIFIER_PORT=9001
# SIROS_VERIFIER_IMAGE=ghcr.io/sirosfoundation/siros-verifier-core@sha256:replace-with-release-digest
